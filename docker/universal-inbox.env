UNIVERSAL_INBOX__DATABASE__USERNAME="universal-inbox"
# Must match POSTGRES_PASSWORD in universal-inbox-db.env. Choose your own.
UNIVERSAL_INBOX__DATABASE__PASSWORD=""
UNIVERSAL_INBOX__DATABASE__HOST="universal-inbox-db"

UNIVERSAL_INBOX__REDIS__HOST="universal-inbox-redis"

# Required: the server refuses to start with empty keys or with the development
# keys committed to the repository.
# Generate with `openssl rand -base64 64`
UNIVERSAL_INBOX__APPLICATION__HTTP_SESSION__SECRET_KEY=""
# Generate the pair with `just generate-jwt-key-pair`
# (or `universal-inbox-api generate-jwt-key-pair`)
UNIVERSAL_INBOX__APPLICATION__HTTP_SESSION__JWT_SECRET_KEY=""
UNIVERSAL_INBOX__APPLICATION__HTTP_SESSION__JWT_PUBLIC_KEY=""

AUTHENTICATION__LOCAL__ENABLED=true
AUTHENTICATION__PASSKEY__ENABLED=true

# For Google Authorization Code Flow
# AUTH__GOOGLE__OIDC_API_CLIENT_ID=
# AUTH__GOOGLE__OIDC_API_CLIENT_SECRET=
# AUTH__GOOGLE__OIDC_FLOW_SETTINGS__TYPE=GoogleAuthorizationCodeFlow
# AUTH__GOOGLE__OIDC_ISSUER_URL=https://accounts.google.com
# AUTH__GOOGLE__USER_PROFILE_URL=https://accounts.google.com

UNIVERSAL_INBOX__APPLICATION__FRONT_BASE_URL="http://localhost:8000"

UNIVERSAL_INBOX__OAUTH2__NANGO_BASE_URL="https://nango-server:3003"
# get it from Nango/project-settings page http://localhost:3003/project-settings
UNIVERSAL_INBOX__OAUTH2__NANGO_SECRET_KEY=""
# get it from Nango/project-settings page http://localhost:3003/project-settings
UNIVERSAL_INBOX__OAUTH2__NANGO_PUBLIC_KEY=""

# Email configuration
UNIVERSAL_INBOX__APPLICATION__EMAIL__SMTP_SERVER=""
UNIVERSAL_INBOX__APPLICATION__EMAIL__SMTP_PORT=465
UNIVERSAL_INBOX__APPLICATION__EMAIL__SMTP_USERNAME=""
UNIVERSAL_INBOX__APPLICATION__EMAIL__SMTP_PASSWORD=""

# Optional: to enable tracing
# UNIVERSAL_INBOX__APPLICATION__OBSERVABILITY__TRACING__OTLP_EXPORTER_HEADERS_AUTHORIZATION=""
# UNIVERSAL_INBOX__APPLICATION__OBSERVABILITY__TRACING__OTLP_EXPORTER_ENDPOINT=""

# For debugging
RUST_BACKTRACE=full
