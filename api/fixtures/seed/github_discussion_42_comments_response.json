                    "id": "DC_seed_11",
                    "bodyHTML": "<p>Fully agree. Archive by default, and delete stays behind <code>#</code> with a confirmation.</p>",
                    "url": "https://github.com/universal-inbox/universal-inbox/discussions/42#discussioncomment-11",
                    "createdAt": "{{ago_30m}}",
