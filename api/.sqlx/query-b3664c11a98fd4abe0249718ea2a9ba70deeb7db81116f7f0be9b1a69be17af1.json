{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                  task.id as task_id,\n                  task.context_id,\n                  third_party_item.id as item_id,\n                  third_party_item.data_enc as \"data_enc!\"\n                FROM task\n                JOIN third_party_item ON task.source_item_id = third_party_item.id\n                WHERE task.user_id = $1\n                  AND third_party_item.kind::TEXT = 'TodoistItem'\n            ",
