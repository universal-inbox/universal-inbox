  "db_name": "PostgreSQL",
  "query": "\n                UPDATE context\n                SET name = $1, parent_id = $2, updated_at = $3\n                WHERE id = $4\n                  AND binding_mirrored IS NOT TRUE\n                RETURNING\n                  id,\n                  user_id,\n                  parent_id,\n                  name,\n                  binding_provider::TEXT as \"binding_provider?\",\n                  binding_source_id,\n                  binding_mirrored,\n                  status::TEXT as \"status!\",\n                  is_inbox,\n                  note_id,\n                  created_at,\n                  updated_at\n            ",
