  "db_name": "PostgreSQL",
  "query": "\n                SELECT task.id, third_party_item.source_id\n                FROM task\n                JOIN third_party_item ON third_party_item.id = task.source_item_id\n                WHERE task.user_id = $1\n                  AND task.kind::TEXT = $2\n                  AND third_party_item.source_id = ANY($3)\n            ",
