  "query": "\n                SELECT\n                  id,\n                  user_id,\n                  parent_id,\n                  name,\n                  binding_provider::TEXT as \"binding_provider?\",\n                  binding_source_id,\n                  binding_mirrored,\n                  status::TEXT as \"status!\",\n                  note_id,\n                  created_at,\n                  updated_at\n                FROM context\n                WHERE user_id = $1\n                ORDER BY created_at ASC, id ASC\n            ",
